# Postgres. Utan den kör appen en inbäddad PGlite i ./.pgdata, vilket
# räcker lokalt men inte i drift — Vercels filsystem är läsbart bara.
#
# Supabase: använd anslutningen från Connection Pooling (port 6543).
# Den direkta anslutningen på 5432 tar slut på anslutningar i serverless.
DATABASE_URL=postgresql://postgres.PROJEKT:LÖSENORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# TransPA Public API. Fås från Visma Developer Portal efter att
# organisationen registrerats och access beviljats.
TRANSPA_CLIENT_ID=
TRANSPA_CLIENT_SECRET=
TRANSPA_TENANT_ID=
